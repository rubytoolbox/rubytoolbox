// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ruby-rails-postgres
{
  "name": "The Ruby Toolbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},

  // 5000 is the main rails app server
  // 3036 is the vite dev server (assets are proxied through rails, but direct access helps debugging)
  // 4444 is the selenium chrome grid management UI
  // 7900 is the selenium chrome VNC remote UI
  "forwardPorts": [5000, 3036, 4444, 7900],

  "postCreateCommand": "mise trust && mise install && mise run setup && bin/pull_database && mise exec -- overcommit --install && atuin import bash" ,

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "Shopify.ruby-lsp",
        "EditorConfig.EditorConfig"
      ]
    },
    "codespaces": {
      "openFiles": [
        ".devcontainer/README.md",
        "README.md",
      ]
    }
  }
}
